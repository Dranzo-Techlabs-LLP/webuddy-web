# Clariva Web - Element Call on its OWN origin (a cPanel subdomain such as call.<your-domain>).
# TEMPLATE: copy to <call-docroot>/.htaccess and replace the two @@PLACEHOLDERS@@ below.
# Required before a PUBLIC launch (docs/clariva/DEPLOY.md section 7 and checklist). Why: on the web app's own origin Element Call's
# JavaScript can read everything the app stores for that origin, including the Matrix access token.
#
# Setup (docs/clariva/DEPLOY-CPANEL.md section G):
#   1. cPanel > Domains: create call.<your-domain> with its OWN, empty document root; run AutoSSL.
#   2. Put the CONTENTS of the zip's element-call/ folder (index.html, config.json, assets/) at the TOP of that document root.
#   3. Copy this file there as .htaccess and fill in the @@ placeholders.
#   4. In the web app's config.json add:   "element_call": { "url": "https://call.<your-domain>/" }
#   5. Keep the Content-Security-Policy-Report-Only header until a real voice AND video call has run with the browser console open
#      and shows no violations, then rename it to Content-Security-Policy (see the note at that header).
#
# UNVERIFIED in production: the policies below were checked for syntax and for the framing rules on a test Apache only.

Options -Indexes
DirectoryIndex index.html
ServerSignature Off

<FilesMatch "^\.ht">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # HTTPS only (getUserMedia needs a secure context); AutoSSL validation paths and TLS-terminating proxies are respected.
    RewriteCond %{REQUEST_URI} !^/\.well-known/(acme-challenge|pki-validation|cpanel-dcv)/
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/\S*)\sHTTP/
    RewriteRule ^ https://%{HTTP_HOST}%1 [R=301,NE,L]

    # Element Call's own index.html for an unknown PAGE (missing assets stay 404).
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{HTTP:Accept} text/html [NC]
    RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType text/javascript .js .mjs
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/wasm image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    RequestHeader edit "If-None-Match" '^"(.*)-gzip"$' '"$1"'

    Header always set X-Content-Type-Options "nosniff"
    # NO X-Frame-Options here and NO "frame-ancestors 'self'": the web app (another origin) frames this page. Only the web app may.
    # @@WEB_ORIGIN@@ = the exact origin of the web app WITHOUT the scheme, e.g. app.example.com (scheme and port stay as written).
    Header always set Content-Security-Policy "frame-ancestors https://@@WEB_ORIGIN@@"

    # The directive that bounds where Element Call can send the user's OpenID token (the LiveKit JWT service is read from room
    # state, so a hostile membership event could name any host). Report-Only first: nobody has run a call under this policy yet.
    # @@LIVEKIT_HOST@@ = the host of the LiveKit SFU websocket (the JWT service answers its "url" with it), e.g. livekit.example.com
    # If avatars / files are shown inside the call UI, also add the https origin of the Matrix media repo to img-src.
    # Once a real call shows NO violation in the browser console, change "Header always set Content-Security-Policy-Report-Only"
    # into "Header always add Content-Security-Policy": browsers enforce several CSP headers together, so the frame-ancestors
    # header above stays in force.
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-pQY0fuQAnnVQH5nQfjo80rzGkQzeN3JeAtAJ+1KcD4k='; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://matrix.clarivahub.com; media-src 'self' blob: data:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' https://matrix.clarivahub.com https://clarivahub.com https://matrix-rtc.clarivahub.com wss://@@LIVEKIT_HOST@@; object-src 'none'; base-uri 'self'"

    # Never send Permissions-Policy that blocks camera / microphone, and never Cross-Origin-Opener-Policy / -Embedder-Policy here.

    # Cache policy: index.html and config.json are revalidated; assets/ is content-hashed (see assets/.htaccess below).
    <FilesMatch "^(index\.html|config\.json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# ALSO create assets/.htaccess with exactly this content (the parent FilesMatch rules would otherwise win):
#   <IfModule mod_headers.c>
#       <FilesMatch ".">
#           Header set Cache-Control "public, max-age=31536000, immutable"
#       </FilesMatch>
#   </IfModule>
